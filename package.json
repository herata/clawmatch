{
	"name": "clawmatch",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"prepare": "husky",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"elysia": "^1.4.22"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@types/node": "^25.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.63.0"
	}
}
